# =============================================================================
# KURA CP4 · ACR/ACI · .env.example
# Copie para .env e preencha antes de rodar: cp .env.example .env
# NUNCA commite o .env real — já está no .gitignore deste repo.
#
# Nomenclatura de env var alinhada com o que os apps REALMENTE leem hoje
# (conferido em backend-clinica-dotnet/src/Kura.Api, application-prod.yml de
# backend-tutor-java e DevOps-Cloud/docker-compose.yml — não inventado).
# =============================================================================

# ─── Identificação do grupo (RUBRICA: prefixo RM562999 em TODOS os recursos) ──
RM=RM562999

# ─── Azure — nomes de recurso ─────────────────────────────────────────────────
# Resource group, região e nomes que os scripts usam. ACR e Storage Account
# exigem nome GLOBALMENTE único no Azure inteiro — se "rm562999kuraacr" ou
# "rm562999kurastorage" já estiverem em uso por outra conta, troque o sufixo
# aqui (ex.: rm562999kuraacr2) antes de rodar deploy.sh.
AZURE_RESOURCE_GROUP=rm562999-kura-cp4-rg
# ATENCAO (achado real da sessao 2): subscriptions de aluno FIAP costumam ter
# a policy "Allowed resource deployment regions" ligada, e centralus NAO esta
# na lista. O sintoma e o deploy.sh morrer no passo [2/9] com
# (RequestDisallowedByAzure) "...was disallowed by Azure: This policy maintains
# a set of best available regions...". Confira ANTES de rodar com:
#   az policy assignment list \n#     --query "[?displayName=='Allowed resource deployment regions'].parameters" -o json
# e use uma das regioes listadas ali (na subscription RM566315 a lista era
# southafricanorth, eastus, brazilsouth, chilecentral, eastus2).
AZURE_LOCATION=centralus
ACR_NAME=rm562999kuraacr
STORAGE_ACCOUNT_NAME=rm562999kurastorage
STORAGE_FILE_SHARE_NAME=kura-oracle-data
# Quota de espaço do Azure Files share, em GB — Oracle XE + dado de demo cabe
# folgado em 10GB.
STORAGE_FILE_SHARE_QUOTA_GB=10

# Ligar/desligar o 3º ACI opcional (backend Java) — ver seção "EXTRA" do
# deploy.sh. false = só o núcleo exigido pela rubrica (Oracle + .NET) sobe.
DEPLOY_JAVA_BONUS=false

# ─── Oracle XE (banco containerizado) ────────────────────────────────────────
# Gere com: openssl rand -base64 32
ORACLE_SYS_PASSWORD=
ORACLE_APP_USER=RM562999
# Gere com: openssl rand -base64 32
ORACLE_APP_PASSWORD=
# Nome de serviço do PDB — é o default da imagem gvenzl/oracle-xe:21-slim,
# igual ao que o DevOps-Cloud/docker-compose.yml usa (oracle-db:1521/XEPDB1).
ORACLE_PDB_SERVICE=XEPDB1

# ─── .NET API (backend clínica, porta 8080) ──────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# Gere com: openssl rand -base64 48
DOTNET_JWT_KEY=
# Gere com: openssl rand -base64 32
IOT_API_KEY=
# Gere com: openssl rand -base64 32
LUNA_API_KEY=
# Mesma variável usada pelo lado Luna (fora do escopo deste CP4) — aqui só
# precisa ter algum valor não vazio para o .NET subir, já que o binding
# Luna:InboundApiKey é lido incondicionalmente (não é opcional como o Daily).
# Gere com: openssl rand -base64 32
LUNA_INBOUND_API_KEY=
# Daily.co (teleconsulta) — sem isto o .NET aplica fallback de link manual em
# vez de falhar (ver DailyService.cs no repo fonte). Dummy é aceitável no CP4.
DAILY_API_KEY=kura-daily-dummy-key-2026
# Luna não é implantada neste CP4 — endereço dummy só para o binding não ficar
# vazio; nenhuma chamada real de transcrição vai ser feita.
LUNA_BASE_URL=http://luna-ai-nao-implantada-neste-cp4:8000
# Pasta onde o kura-api grava PDF de receituário dentro do container. Em ACI,
# sem volume dedicado para o app .NET (só o Oracle usa Azure Files neste CP4),
# então isto vive na camada gravável do container e SOME a cada recreate —
# aceitável para o escopo do CP4 (ver NOTAS-PARA-O-MAESTRO.md).
STORAGE_BASE_PATH=/data/kura/receituarios

# ─── Java API (backend tutor, porta 8081) — só usado se DEPLOY_JAVA_BONUS=true
# Gere com: openssl rand -base64 64
JAVA_JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Caminhos locais dos repos-fonte (usados só pelo `docker build`) ─────────
# app-dotnet/Dockerfile e app-java/Dockerfile são CÓPIAS FIÉIS dos Dockerfiles
# originais — eles fazem `COPY src/...` relativo à RAIZ do repo fonte, não a
# esta pasta. Por isso o `docker build` do deploy.sh precisa rodar com esses
# caminhos como contexto, não com app-dotnet//app-java/. Ajuste se os repos
# estiverem em outro lugar nesta máquina — o caminho varia por máquina (ver
# aviso equivalente no CLAUDE.md do workspace `dev VsClaude`); confirme com
# `ls` antes de rodar deploy.sh se não tiver certeza.
SRC_DOTNET_REPO_PATH=../backend-clinica-dotnet
SRC_JAVA_REPO_PATH=../backend-tutor-java
